# Healthcare Referral Tracker — Environment Variables
# Copy this file to .env and fill in your values

# ─── MONGODB ATLAS ───
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://bkitib:j5jfSsYB9rP6Iw0W@referralsystem.v9bhz03.mongodb.net/healthtrack?retryWrites=true&w=majority&appName=Referralsystem

# ─── SERVER ───
NODE_ENV=production
PORT=10000

# ─── JWT SECRET ───
# Generate a strong random string (64+ characters recommended)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── CORS ───
# Comma-separated list of allowed origins
# The Kimi frontend URL + any additional domains
CORS_ORIGIN=https://oizwnscb3c4jm.kimi.show

# ─── GMAIL SMTP ───
# Your Gmail app password (NOT your Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bkitib@gmail.com
SMTP_PASS=ubyi sesm vhsx aopv
SMTP_FROM=Healthcare Referral Tracker <bkitib@gmail.com>

# ─── SYNC ───
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRY=5

# ─── AFRICA'S TALKING SMS ───
# Sign up at: https://account.africastalking.com
# For Kenya healthcare SMS — local routes, affordable
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_FROM=HealthTrack

# ─── WEB PUSH NOTIFICATIONS ───
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:bkitib@gmail.com

# ─── LOGGING ───
LOG_LEVEL=info
