# Patient Referral Tracker — Environment Variables
# Copy this file to .env and fill in your values

# ─── MONGODB ATLAS ───
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=YourApp

# ─── SERVER ───
NODE_ENV=production
PORT=10000

# ─── JWT SECRET ───
# Generate a strong random string (64+ characters recommended)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── CORS ───
# Comma-separated list of allowed origins
# The frontend URL + any additional domains
CORS_ORIGIN=https://your-frontend-url.com

# ─── GMAIL SMTP ───
# Your Gmail app password (NOT your Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your app password
SMTP_FROM=Patient Referral Tracker <no-reply@example.com>

# ─── SYNC ───
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRY=5

# ─── AFRICA'S TALKING SMS ───
# Sign up at: https://account.africastalking.com
# For Kenya healthcare SMS — local routes, affordable
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_FROM=PatientTrack

# ─── WEB PUSH NOTIFICATIONS ───
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# ─── LOGGING ───
LOG_LEVEL=info
